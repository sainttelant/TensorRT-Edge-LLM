{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Alpamayo: action inference (C++ debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-orin-debug/bin/action_inference",
            "args": [
                "--engine-dir",
                "${workspaceFolder}/tensorrt-edgellm-workspace/R1_10B/engines/llm",
                "--multimodal-engine-dir",
                "${workspaceFolder}/tensorrt-edgellm-workspace/R1_10B/engines",
                "--checkpoint-dir",
                "${workspaceFolder}/tensorrt-edgellm-workspace/R1_10B/checkpoint",
                "--input-file",
                "${workspaceFolder}/VLA_tests/selected/26f8dc7e-a9a2-4302-b847-af2009abf677/input_action.json",
                "--output-file",
                "${workspaceFolder}/tensorrt-edgellm-workspace/R1_10B/output_action.json",
                "--batch-size",
                "1",
                "--noise-seed",
                "5",
                "--dump-profile",
                "--profile-output-file",
                "${workspaceFolder}/tensorrt-edgellm-workspace/R1_10B/profile_action.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/usr/lib:/usr/lib64:/usr/lib/aarch64-linux-gnu:${env:LD_LIBRARY_PATH}"
                },
                {
                    "name": "EDGELLM_PLUGIN_PATH",
                    "value": "${workspaceFolder}/build-orin-debug/lib/libNvInfer_edgellm_plugin.so"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Build action_inference (Debug)",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
