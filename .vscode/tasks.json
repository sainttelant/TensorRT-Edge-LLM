{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure action_inference Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-orin-debug",
                "-DTRT_PACKAGE_DIR=/usr",
                "-DCUDA_DIR=/usr/local/cuda",
                "-DCUDA_CTK_VERSION=13.2",
                "-DEMBEDDED_TARGET=jetson-orin",
                "-DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc",
                "-DCMAKE_CUDA_ARCHITECTURES=87",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build action_inference (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-orin-debug",
                "--target",
                "action_inference",
                "NvInfer_edgellm_plugin",
                "--parallel",
                "8"
            ],
            "dependsOn": "Configure action_inference Debug",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
